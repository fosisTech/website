# Public (client-exposed) variables
# Set to https://fosis.org.uk on the production deployment only. Any other value
# (or unset) makes robots.txt disallow everything and adds noindex to every page.
# NEXT_PUBLIC_APP_URL=https://fosis.org.uk

# Server-only variables (add when integrating Clerk, Convex, etc.)
# CLERK_SECRET_KEY=
# CONVEX_DEPLOYMENT=
